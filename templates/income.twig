{% include 'layout_header.twig' %}

<div class="d-flex justify-content-between align-items-center mb-3">
  <div>
    <h2 class="mb-0 fw-bold"><i class="bi bi-cash-stack text-primary me-2"></i>Income — {{ selectedYear }}</h2>
    <p class="text-muted small mb-0">Enter each month's salary as it's paid. Other Income totals automatically from Other Income Log.</p>
  </div>
  <a href="csv_export.php?type=income&year={{ selectedYear }}" class="btn btn-sm btn-outline-success"><i class="bi bi-file-earmark-spreadsheet me-1"></i> Export CSV</a>
</div>

<div class="card p-3 shadow-sm">
  <form method="post">
    {{ csrf_field() }}
    <input type="hidden" name="year" value="{{ selectedYear }}">
    <div class="table-responsive">
      <table class="table table-sm align-middle mb-0">
        <thead>
          <tr>
            <th>Month</th>
            <th>Salary ({{ symbol }})</th>
            <th>Other Income</th>
            <th>Total Income</th>
          </tr>
        </thead>
        <tbody>
        {% set totalSalary = 0 %}
        {% set totalOther = 0 %}
        {% for m in MONTHS %}
          {% set sal = salaries[m]|default(0) %}
          {% set oth = otherByMonth[m]|default(0) %}
          {% set totalSalary = totalSalary + sal %}
          {% set totalOther = totalOther + oth %}
          <tr>
            <td class="fw-semibold">{{ m }}</td>
            <td style="max-width: 200px;">
              <input type="number" step="0.01" min="0" name="salary[{{ m }}]" class="form-control form-control-sm input-cell" value="{{ sal }}">
            </td>
            <td class="text-muted">{{ fmt_money(oth, symbol) }}</td>
            <td class="fw-bold positive">{{ fmt_money(sal + oth, symbol) }}</td>
          </tr>
        {% endfor %}
        </tbody>
        <tfoot>
          <tr class="total-row">
            <td>ANNUAL TOTAL</td>
            <td>{{ fmt_money(totalSalary, symbol) }}</td>
            <td>{{ fmt_money(totalOther, symbol) }}</td>
            <td class="positive">{{ fmt_money(totalSalary + totalOther, symbol) }}</td>
          </tr>
        </tfoot>
      </table>
    </div>
    <div class="mt-3">
      <button class="btn btn-primary" type="submit"><i class="bi bi-save me-1"></i> Save Salaries</button>
    </div>
  </form>
</div>

{% include 'layout_footer.twig' %}
