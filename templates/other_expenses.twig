{% include 'layout_header.twig' %}

<div class="d-flex justify-content-between align-items-center mb-3">
  <div>
    <h2 class="mb-0 fw-bold"><i class="bi bi-box-arrow-up text-danger me-2"></i>Other / Unplanned Expense Log</h2>
    <p class="text-muted small mb-0">Anything outside regular budget (emergencies, one-offs). Totals automatically into "Other / Unplanned Expense" line on Tracker.</p>
  </div>
  <a href="csv_export.php?type=other_expenses" class="btn btn-sm btn-outline-success"><i class="bi bi-file-earmark-spreadsheet me-1"></i> Export CSV</a>
</div>

<div class="row g-4">
  <!-- Add Entry Form -->
  <div class="col-lg-4">
    <div class="card p-3 shadow-sm">
      <h5 class="fw-bold mb-3"><i class="bi bi-plus-circle text-primary me-2"></i>Add Entry</h5>
      <form method="post">
        {{ csrf_field() }}
        <input type="hidden" name="action" value="create">
        <div class="row g-2 mb-2">
          <div class="col-6">
            <label class="form-label small">Year</label>
            <select name="year" class="form-select form-select-sm">
              {% for y in years %}<option value="{{ y }}" {% if y == globalSelectedYear %}selected{% endif %}>{{ y }}</option>{% endfor %}
            </select>
          </div>
          <div class="col-6">
            <label class="form-label small">Month</label>
            <select name="month" class="form-select form-select-sm">
              {% for m in MONTHS %}<option value="{{ m }}" {% if m == globalSelectedMonth %}selected{% endif %}>{{ m }}</option>{% endfor %}
            </select>
          </div>
        </div>
        <div class="mb-2">
          <label class="form-label small">Date</label>
          <input type="date" name="entry_date" class="form-control form-control-sm" value="{{ "now"|date("Y-m-d") }}">
        </div>
        <div class="mb-2">
          <label class="form-label small">Description</label>
          <input type="text" name="description" class="form-control form-control-sm" placeholder="e.g. Car repair" required>
        </div>
        <div class="mb-2">
          <label class="form-label small">Amount ({{ symbol }})</label>
          <input type="number" step="0.01" min="0.01" name="amount" class="form-control form-control-sm" required>
        </div>
        <div class="mb-3">
          <label class="form-label small">Notes</label>
          <input type="text" name="notes" class="form-control form-control-sm">
        </div>
        <button class="btn btn-primary w-100" type="submit">Add Entry</button>
      </form>
    </div>
  </div>

  <!-- Recent Entries with Search & Pagination -->
  <div class="col-lg-8">
    <div class="card p-3 shadow-sm">
      <div class="d-flex justify-content-between align-items-center mb-3">
        <h5 class="fw-bold mb-0"><i class="bi bi-list-check text-secondary me-2"></i>Expense Entries</h5>
        <span class="badge bg-light text-dark border">{{ totalRows }} total entries</span>
      </div>

      <!-- Filter Bar -->
      <form method="get" class="row g-2 mb-3 bg-light p-2 rounded border">
        <div class="col-md-4">
          <input type="text" name="search" class="form-control form-control-sm" placeholder="Search description or notes..." value="{{ filterSearch }}">
        </div>
        <div class="col-md-3">
          <select name="filter_year" class="form-select form-select-sm">
            <option value="">All Years</option>
            {% for y in years %}<option value="{{ y }}" {% if filterYear == y %}selected{% endif %}>{{ y }}</option>{% endfor %}
          </select>
        </div>
        <div class="col-md-3">
          <select name="filter_month" class="form-select form-select-sm">
            <option value="">All Months</option>
            {% for m in MONTHS %}<option value="{{ m }}" {% if filterMonth == m %}selected{% endif %}>{{ m }}</option>{% endfor %}
          </select>
        </div>
        <div class="col-md-2">
          <button class="btn btn-sm btn-secondary w-100" type="submit">Filter</button>
        </div>
      </form>

      <div class="table-responsive">
        <table class="table table-sm align-middle">
          <thead>
            <tr>
              <th>Date</th><th>Year/Mo</th><th>Description</th><th class="text-end">Amount</th><th>Notes</th><th></th>
            </tr>
          </thead>
          <tbody>
          {% for e in entries %}
            <tr>
              <td class="small">{{ e.entry_date }}</td>
              <td class="small fw-semibold">{{ e.year }} {{ e.month }}</td>
              <td class="fw-semibold">{{ e.description }}</td>
              <td class="text-end fw-bold negative">{{ fmt_money(e.amount, symbol) }}</td>
              <td class="small text-muted">{{ e.notes }}</td>
              <td class="text-end">
                <form method="post" onsubmit="return confirm('Delete this entry?');" class="d-inline">
                  {{ csrf_field() }}
                  <input type="hidden" name="action" value="delete">
                  <input type="hidden" name="id" value="{{ e.id }}">
                  <button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                </form>
              </td>
            </tr>
          {% endfor %}
          {% if entries|length == 0 %}
            <tr><td colspan="6" class="text-muted text-center py-4">No entries found matching criteria.</td></tr>
          {% endif %}
          </tbody>
        </table>
      </div>

      {% if totalPages > 1 %}
      <nav class="d-flex justify-content-center mt-3">
        <ul class="pagination pagination-sm mb-0">
          {% for p in 1..totalPages %}
            <li class="page-item {% if p == currentPage %}active{% endif %}">
              <a class="page-link" href="?page={{ p }}&search={{ filterSearch|url_encode }}&filter_year={{ filterYear }}&filter_month={{ filterMonth }}">{{ p }}</a>
            </li>
          {% endfor %}
        </ul>
      </nav>
      {% endif %}
    </div>
  </div>
</div>

{% include 'layout_footer.twig' %}
