{% include 'layout_header.twig' %}

<div class="d-flex justify-content-between align-items-center mb-3">
  <div>
    <h2 class="mb-0 fw-bold"><i class="bi bi-arrow-left-right text-primary me-2"></i>Transfer / Rollover Log</h2>
    <p class="text-muted small mb-0">Move money between budget buckets automatically — both buckets' In/Out and Closing update.</p>
  </div>
  <a href="csv_export.php?type=transfers" class="btn btn-sm btn-outline-success"><i class="bi bi-file-earmark-spreadsheet me-1"></i> Export CSV</a>
</div>

<!-- Recurring Transfer Templates Bar -->
<div class="card p-3 shadow-sm mb-4 border-start border-4 border-info">
  <div class="d-flex justify-content-between align-items-center mb-2">
    <h6 class="fw-bold mb-0"><i class="bi bi-arrow-repeat text-info me-2"></i>Recurring Transfer Templates</h6>
    <button class="btn btn-sm btn-outline-primary" type="button" data-bs-toggle="collapse" data-bs-target="#newTemplateForm">
      <i class="bi bi-plus-lg me-1"></i> New Template
    </button>
  </div>

  <div class="collapse mb-3" id="newTemplateForm">
    <div class="p-3 bg-light rounded border">
      <form method="post" class="row g-2 align-items-end">
        {{ csrf_field() }}
        <input type="hidden" name="action" value="save_template">
        <div class="col-md-3">
          <label class="form-label small">Template Name</label>
          <input type="text" name="template_name" class="form-control form-control-sm" placeholder="e.g. Gas to Savings Sweep" required>
        </div>
        <div class="col-md-3">
          <label class="form-label small">From Category</label>
          <select name="from_category_id" class="form-select form-select-sm" required>
            {% for c in categories %}<option value="{{ c.id }}">{{ c.name }}</option>{% endfor %}
          </select>
        </div>
        <div class="col-md-3">
          <label class="form-label small">To Category</label>
          <select name="to_category_id" class="form-select form-select-sm" required>
            {% for c in categories %}<option value="{{ c.id }}">{{ c.name }}</option>{% endfor %}
          </select>
        </div>
        <div class="col-md-2">
          <label class="form-label small">Amount ({{ symbol }})</label>
          <input type="number" step="0.01" min="0.01" name="amount" class="form-control form-control-sm" required>
        </div>
        <div class="col-md-1">
          <button class="btn btn-sm btn-primary w-100" type="submit">Save</button>
        </div>
      </form>
    </div>
  </div>

  {% if templates|length > 0 %}
  <div class="d-flex flex-wrap gap-2 align-items-center mt-2">
    {% for t in templates %}
      <div class="btn-group btn-group-sm" role="group">
        <form method="post" class="d-inline">
          {{ csrf_field() }}
          <input type="hidden" name="action" value="apply_template">
          <input type="hidden" name="template_id" value="{{ t.id }}">
          <button class="btn btn-sm btn-outline-info" type="submit" title="Apply 1-click transfer to {{ globalSelectedMonth }} {{ globalSelectedYear }}">
            <i class="bi bi-lightning-charge-fill me-1"></i> {{ t.name }} ({{ fmt_money(t.amount, symbol) }})
          </button>
        </form>
        <form method="post" class="d-inline" onsubmit="return confirm('Delete template {{ t.name }}?');">
          {{ csrf_field() }}
          <input type="hidden" name="action" value="delete_template">
          <input type="hidden" name="template_id" value="{{ t.id }}">
          <button class="btn btn-sm btn-outline-danger" type="submit"><i class="bi bi-x"></i></button>
        </form>
      </div>
    {% endfor %}
  </div>
  {% else %}
    <div class="small text-muted">No recurring transfer templates saved yet. Create one above to execute monthly sweeps with 1 click!</div>
  {% endif %}
</div>

<div class="row g-4">
  <!-- Log New Transfer Form -->
  <div class="col-lg-4">
    <div class="card p-3 shadow-sm">
      <h5 class="fw-bold mb-3"><i class="bi bi-plus-circle text-primary me-2"></i>Log a Transfer</h5>
      <form method="post">
        {{ csrf_field() }}
        <input type="hidden" name="action" value="create">
        <div class="row g-2 mb-2">
          <div class="col-6">
            <label class="form-label small">Year</label>
            <select name="year" class="form-select form-select-sm">
              {% for y in years %}<option value="{{ y }}" {% if y == globalSelectedYear %}selected{% endif %}>{{ y }}</option>{% endfor %}
            </select>
          </div>
          <div class="col-6">
            <label class="form-label small">Month</label>
            <select name="month" class="form-select form-select-sm">
              {% for m in MONTHS %}<option value="{{ m }}" {% if m == globalSelectedMonth %}selected{% endif %}>{{ m }}</option>{% endfor %}
            </select>
          </div>
        </div>
        <div class="mb-2">
          <label class="form-label small">Date</label>
          <input type="date" name="entry_date" class="form-control form-control-sm" value="{{ "now"|date("Y-m-d") }}">
        </div>
        <div class="mb-2">
          <label class="form-label small">From Bucket</label>
          <select name="from_category_id" class="form-select form-select-sm" required>
            {% for c in categories %}<option value="{{ c.id }}">{{ c.name }}</option>{% endfor %}
          </select>
        </div>
        <div class="mb-2">
          <label class="form-label small">To Bucket</label>
          <select name="to_category_id" class="form-select form-select-sm" required>
            {% for c in categories %}<option value="{{ c.id }}">{{ c.name }}</option>{% endfor %}
          </select>
        </div>
        <div class="mb-2">
          <label class="form-label small">Amount ({{ symbol }})</label>
          <input type="number" step="0.01" min="0.01" name="amount" class="form-control form-control-sm" required>
        </div>
        <div class="mb-2">
          <label class="form-label small">Reason / Note</label>
          <input type="text" name="reason" class="form-control form-control-sm">
        </div>
        <div class="mb-3">
          <label class="form-label small">Approved?</label>
          <select name="approved" class="form-select form-select-sm">
            <option>Yes</option><option selected>Pending</option><option>No</option>
          </select>
        </div>
        <button class="btn btn-primary w-100" type="submit">Log Transfer</button>
      </form>
    </div>
  </div>

  <!-- Recent Transfers List with Filter & Pagination -->
  <div class="col-lg-8">
    <div class="card p-3 shadow-sm">
      <div class="d-flex justify-content-between align-items-center mb-3">
        <h5 class="fw-bold mb-0"><i class="bi bi-clock-history text-secondary me-2"></i>Transfers Log</h5>
        <span class="badge bg-light text-dark border">{{ totalRows }} total entries</span>
      </div>

      <!-- Filter Bar -->
      <form method="get" class="row g-2 mb-3 bg-light p-2 rounded border">
        <div class="col-md-4">
          <input type="text" name="search" class="form-control form-control-sm" placeholder="Search reason or category..." value="{{ filterSearch }}">
        </div>
        <div class="col-md-3">
          <select name="filter_year" class="form-select form-select-sm">
            <option value="">All Years</option>
            {% for y in years %}<option value="{{ y }}" {% if filterYear == y %}selected{% endif %}>{{ y }}</option>{% endfor %}
          </select>
        </div>
        <div class="col-md-3">
          <select name="filter_month" class="form-select form-select-sm">
            <option value="">All Months</option>
            {% for m in MONTHS %}<option value="{{ m }}" {% if filterMonth == m %}selected{% endif %}>{{ m }}</option>{% endfor %}
          </select>
        </div>
        <div class="col-md-2">
          <button class="btn btn-sm btn-secondary w-100" type="submit">Filter</button>
        </div>
      </form>

      <div class="table-responsive">
        <table class="table table-sm align-middle">
          <thead>
            <tr>
              <th>Date</th><th>Year/Mo</th><th>From</th><th>To</th><th class="text-end">Amount</th><th>Reason</th><th>Status</th><th></th>
            </tr>
          </thead>
          <tbody>
          {% for t in transfers %}
            <tr>
              <td class="small">{{ t.entry_date }}</td>
              <td class="small fw-semibold">{{ t.year }} {{ t.month }}</td>
              <td><span class="badge bg-danger-subtle text-danger border border-danger-subtle">{{ t.from_name }}</span></td>
              <td><span class="badge bg-success-subtle text-success border border-success-subtle">{{ t.to_name }}</span></td>
              <td class="text-end fw-bold">{{ fmt_money(t.amount, symbol) }}</td>
              <td class="small text-muted">{{ t.reason }}</td>
              <td>
                <span class="badge {% if t.approved == 'Yes' %}bg-success{% elseif t.approved == 'Pending' %}bg-warning text-dark{% else %}bg-secondary{% endif %}">
                  {{ t.approved }}
                </span>
              </td>
              <td class="text-end">
                <form method="post" onsubmit="return confirm('Delete this transfer?');" class="d-inline">
                  {{ csrf_field() }}
                  <input type="hidden" name="action" value="delete">
                  <input type="hidden" name="id" value="{{ t.id }}">
                  <button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                </form>
              </td>
            </tr>
          {% endfor %}
          {% if transfers|length == 0 %}
            <tr><td colspan="8" class="text-muted text-center py-4">No transfers found matching criteria.</td></tr>
          {% endif %}
          </tbody>
        </table>
      </div>

      <!-- Pagination -->
      {% if totalPages > 1 %}
      <nav class="d-flex justify-content-center mt-3">
        <ul class="pagination pagination-sm mb-0">
          {% for p in 1..totalPages %}
            <li class="page-item {% if p == currentPage %}active{% endif %}">
              <a class="page-link" href="?page={{ p }}&search={{ filterSearch|url_encode }}&filter_year={{ filterYear }}&filter_month={{ filterMonth }}">{{ p }}</a>
            </li>
          {% endfor %}
        </ul>
      </nav>
      {% endif %}
    </div>
  </div>
</div>

{% include 'layout_footer.twig' %}
