{% include 'layout_header.twig' %}

<div class="d-flex justify-content-between align-items-center mb-3">
  <div>
    <h2 class="mb-0 fw-bold"><i class="bi bi-gear text-primary me-2"></i>Budget Settings</h2>
    <p class="text-muted small mb-0">Define category rules (Fixed vs % of Salary) and manage options.</p>
  </div>
</div>

<div class="row g-4">
  <!-- Categories List -->
  <div class="col-lg-7">
    <div class="card p-3 shadow-sm">
      <div class="table-responsive">
        <table class="table table-sm align-middle mb-0">
          <thead>
            <tr><th>Category</th><th>Group</th><th>Basis</th><th>Amount / %</th><th>Notes</th><th></th></tr>
          </thead>
          <tbody>
          {% for cat in categories %}
            <tr>
              <td>
                <span class="fw-semibold">{{ cat.name }}</span>
                {% if cat.is_other %}<span class="badge bg-secondary ms-1">Auto Log</span>{% endif %}
              </td>
              <td><span class="badge bg-light text-dark border">{{ cat.group_name }}</span></td>
              <td>
                {% if cat.basis == 'percent' %}
                  <span class="badge bg-info-subtle text-info-emphasis">% of Salary</span>
                {% else %}
                  <span class="badge bg-secondary-subtle text-secondary-emphasis">Fixed</span>
                {% endif %}
              </td>
              <td class="fw-bold">
                {% if cat.basis == 'percent' %}
                  {{ (cat.percent * 100)|number_format(2) }}%
                {% else %}
                  {{ fmt_money(cat.fixed_amount, symbol) }}
                {% endif %}
              </td>
              <td class="small text-muted">{{ cat.notes }}</td>
              <td class="text-end">
                <a class="btn btn-sm btn-outline-secondary" href="settings.php?edit={{ cat.id }}"><i class="bi bi-pencil"></i></a>
                {% if not cat.is_other %}
                <form method="post" class="d-inline" onsubmit="return confirm('Delete this category?');">
                  {{ csrf_field() }}
                  <input type="hidden" name="action" value="delete">
                  <input type="hidden" name="category_id" value="{{ cat.id }}">
                  <button class="btn btn-sm btn-outline-danger" type="submit"><i class="bi bi-trash"></i></button>
                </form>
                {% endif %}
              </td>
            </tr>
          {% endfor %}
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- Form for Add/Edit -->
  <div class="col-lg-5">
    <div class="card p-3 shadow-sm">
      <h5 class="fw-bold mb-3">
        {% if editCat %}
          <i class="bi bi-pencil-square text-primary me-2"></i>Edit Category
        {% else %}
          <i class="bi bi-plus-circle text-primary me-2"></i>Add Category
        {% endif %}
      </h5>
      <form method="post">
        {{ csrf_field() }}
        <input type="hidden" name="action" value="{% if editCat %}update{% else %}create{% endif %}">
        {% if editCat %}<input type="hidden" name="category_id" value="{{ editCat.id }}">{% endif %}

        <div class="mb-2">
          <label class="form-label small">Name</label>
          <input type="text" name="name" class="form-control form-control-sm" required value="{{ editCat.name|default('') }}">
        </div>
        <div class="mb-2">
          <label class="form-label small">Group Name</label>
          <input type="text" name="group_name" class="form-control form-control-sm" placeholder="e.g. Household & Family" value="{{ editCat.group_name|default('') }}">
        </div>
        <div class="mb-2">
          <label class="form-label small">Basis</label>
          <select name="basis" class="form-select form-select-sm" id="basisSelect" onchange="toggleBasis()">
            <option value="fixed" {% if editCat.basis|default('fixed') == 'fixed' %}selected{% endif %}>Fixed Amount</option>
            <option value="percent" {% if editCat.basis|default('') == 'percent' %}selected{% endif %}>% of Salary</option>
          </select>
        </div>
        <div class="mb-2" id="fixedField">
          <label class="form-label small">Fixed Amount ({{ symbol }})</label>
          <input type="number" step="0.01" name="fixed_amount" class="form-control form-control-sm" value="{{ editCat.fixed_amount|default('0') }}">
        </div>
        <div class="mb-2" id="percentField" style="display:none">
          <label class="form-label small">% of Salary</label>
          <input type="number" step="0.01" name="percent" class="form-control form-control-sm" value="{% if editCat.percent is defined %}{{ (editCat.percent * 100)|round(4) }}{% endif %}">
        </div>
        <div class="mb-3">
          <label class="form-label small">Notes</label>
          <textarea name="notes" class="form-control form-control-sm" rows="2">{{ editCat.notes|default('') }}</textarea>
        </div>
        <div class="d-flex gap-2">
          <button class="btn btn-primary flex-grow-1" type="submit">{% if editCat %}Save Changes{% else %}Add Category{% endif %}</button>
          {% if editCat %}<a href="settings.php" class="btn btn-outline-secondary">Cancel</a>{% endif %}
        </div>
      </form>
    </div>
  </div>
</div>

<script>
function toggleBasis() {
  const isPercent = document.getElementById('basisSelect').value === 'percent';
  document.getElementById('fixedField').style.display = isPercent ? 'none' : '';
  document.getElementById('percentField').style.display = isPercent ? '' : 'none';
}
toggleBasis();
</script>

{% include 'layout_footer.twig' %}
